{
  "name": "abisso",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/build-site.mjs",
    "update:contributions": "node scripts/update-contributions.mjs",
    "test": "node --test --test-concurrency=1 tests/test-*.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check-project.mjs && npm run format:check && npm run check:unused",
    "generate:logo": "node scripts/create-abisso-logo.mjs",
    "check:unused": "knip --production --no-config-hints"
  },
  "devDependencies": {
    "knip": "6.44.1",
    "prettier": "3.9.9"
  }
}
